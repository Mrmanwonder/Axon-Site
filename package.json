{
  "name": "axon",
  "version": "0.1.0",
  "description": "Axon \u2014 a study companion for Cambridge (CAIE) students, IGCSE through A Level.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-production-config.mjs && tsc -b && vite build && node scripts/check-production-config.mjs --dist",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test bench/*.test.mjs harness/*.test.mjs",
    "check:config": "node scripts/check-production-config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mrmanwonder/Axon-Site.git"
  },
  "bugs": {
    "url": "https://github.com/Mrmanwonder/Axon-Site/issues"
  },
  "homepage": "https://github.com/Mrmanwonder/Axon-Site#readme",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "katex": "^0.18.6",
    "react": "^19.2.8",
