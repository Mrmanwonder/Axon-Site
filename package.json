{
  "name": "axon",
  "version": "0.1.0",
  "description": "Axon \u2014 a study companion for Cambridge (CAIE) students, IGCSE through A Level.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-production-config.mjs && tsc -b && vite build && node scripts/build-offline-shell.mjs && node scripts/check-production-config.mjs --dist",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test bench/*.test.mjs harness/*.test.mjs",
    "check:config": "node scripts/check-production-config.mjs",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:db": "node --test tests/db/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mrmanwonder/Axon-Site.git"
  },
  "bugs": {
    "url": "https://github.com/Mrmanwonder/Axon-Site/issues"
  },
  "homepage": "https://github.com/Mrmanwonder/Axon-Site#readme",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "29.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "katex": "^0.18.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "private": true,
  "type": "module"
}
