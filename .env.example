# Public browser configuration. Never put service-role keys, provider secrets,
# signing keys, passwords or private tokens in a VITE_* variable.
VITE_SITE_URL=https://example.com

# Supabase's publishable URL/key are currently versioned in src/config.js.
# They are intentionally public and rely on Row Level Security for authority.
# All private backend values belong in Supabase/Cloudflare secret stores; see
# supabase/DEPLOY.md.

# PostHog browser analytics. The project key is a public ingestion identifier,
# not a secret. These are optional because production-safe defaults are compiled
# into src/ui/lib/analytics.ts for the connected Axon project.
VITE_POSTHOG_KEY=phc_CNqB29H3LU4EQvd9yg7r3mb4pPdMAVGzjJQzPB6HZzF6
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_ASSET_HOST=https://us-assets.i.posthog.com
