{
  "layout": {
    "rail-w": {
      "$type": "dimension",
      "$value": "0px",
      "$extensions": {
        "com.axon.modes": {
          "bp-768": "76px",
          "bp-1024": "216px"
        }
      }
    },
    "view-bottom": {
      "$type": "dimension",
      "$value": "calc(128px + {layout.bot-inset})",
      "$extensions": {
        "com.axon.modes": {
          "bp-768": "clamp(30px, 5vh, 56px)"
        }
      }
    },
    "top-inset": {
      "$type": "dimension",
      "$value": "env(safe-area-inset-top, 0px)"
    },
    "bot-inset": {
      "$type": "dimension",
      "$value": "env(safe-area-inset-bottom, 0px)"
    },
    "gutter": {
      "$type": "dimension",
      "$value": "clamp(14px, 4vw, 18px)"
    },
    "text-gutter": {
      "$type": "dimension",
      "$value": "calc({layout.gutter} + 4px)"
    },
    "view-top": {
      "$type": "dimension",
      "$value": "calc({layout.top-inset} + clamp(14px, 3.6vw, 22px))"
    },
    "dock-pad": {
      "$type": "dimension",
      "$value": "max(9px, {layout.bot-inset})"
    }
  },
